/* ── Root ──────────────────────────────────────────── */
.root {
    flex-grow: 1;
    padding: 14px;
    background-color: rgb(38, 38, 40);
}

/* ── Header ──────────────────────────────────────────── */
.header {
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 58, 62);
}

.title {
    font-size: 18px;
    color: rgb(235, 235, 235);
    -unity-font-style: bold;
}

/* ── ScrollView ──────────────────────────────────────── */
.scroll {
    flex-grow: 1;
}

/* ── Card ────────────────────────────────────────────── */
.card {
    background-color: rgb(50, 50, 54);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(62, 62, 68);
    padding: 12px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.card-title {
    font-size: 10px;
    color: rgb(120, 180, 220);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.card-desc {
    font-size: 10px;
    color: rgb(150, 150, 155);
    margin-bottom: 10px;
    white-space: normal;
}

/* ── Buttons ─────────────────────────────────────────── */
.btn {
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 4px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 4px;
    margin-bottom: 0;
    -unity-font-style: bold;
    font-size: 11px;
    transition-duration: 100ms;
}

.btn-tall {
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 12px;
}

.btn-primary { background-color: rgb(70, 150, 95); }
.btn-primary:hover { background-color: rgb(90, 175, 115); }

/* Build mode running - the same button now stops it */
.btn-stop { background-color: rgb(170, 80, 70); }
.btn-stop:hover { background-color: rgb(195, 100, 90); }

.btn-secondary {
    background-color: rgb(75, 75, 80);
    color: rgb(220, 220, 220);
}
.btn-secondary:hover { background-color: rgb(95, 95, 100); }

/* Upsell picks up the gold of the padlock so the two read as one message */
.btn-upsell {
    background-color: rgb(198, 158, 62);
    color: rgb(32, 28, 20);
    margin-top: 6px;
}
.btn-upsell:hover { background-color: rgb(224, 182, 82); }

/* ── Toggles ─────────────────────────────────────────── */
.opt-toggle .unity-toggle__label {
    font-size: 11px;
    color: rgb(185, 185, 190);
    min-width: auto;
}
.solo-toggle {
    margin-top: 8px;
    margin-bottom: 0;
}

/* ── Preview panels ──────────────────────────────────── */
.preview {
    background-color: rgb(28, 30, 36);
    /* 2px on both states so switching the active column never shifts the layout */
    border-width: 2px;
    border-color: rgb(60, 62, 70);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 4px;
    margin-bottom: 2px;
}

.preview-large { height: 260px; }
.preview-small { height: 150px; }

/* Active finish column */
.preview-active {
    border-color: rgb(120, 180, 220);
}

/* Arrows and caption sit BELOW the frame, not on the image. Nothing overlaps
   the preview any more, so nothing can swallow clicks either. */
.carousel-bar {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.carousel-caption {
    flex-grow: 1;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(228, 228, 232);
}

.preview-caption-locked {
    color: rgb(255, 225, 119);
}

/* ── Carousel arrows ─────────────────────────────────── */
.arrow {
    flex-shrink: 0;
    width: 26px;
    height: 22px;
    padding: 0;
    margin: 0;
    border-width: 1px;
    border-color: rgb(80, 82, 90);
    border-radius: 4px;
    background-color: rgb(62, 62, 68);
    color: rgb(225, 225, 230);
    -unity-font-style: bold;
    font-size: 13px;
    transition-duration: 100ms;
}
.arrow:hover {
    background-color: rgb(58, 122, 196);
    border-color: rgb(80, 145, 220);
}

/* ── Lock badge ──────────────────────────────────────── */
.lock-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    -unity-background-scale-mode: scale-to-fit;
}
.lock-badge-large { width: 64px; height: 64px; }
.lock-badge-small { width: 48px; height: 48px; }

/* ── Finish columns ──────────────────────────────────── */
.finish-row {
    flex-direction: row;
    margin-left: -3px;
    margin-right: -3px;
}
.finish-col {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 3px;
    margin-right: 3px;
}

/* ── LITE hint ───────────────────────────────────────── */
.lite-hint {
    font-size: 10px;
    color: rgb(150, 150, 155);
    margin-top: 8px;
    white-space: normal;
}

/* ── Helpers ─────────────────────────────────────────── */
.hidden {
    display: none;
}
